<?xml version="1.0"?>
<package format="2">
  <name>franka_weight_lift</name>
  <version>0.1.0</version>
  <description>franka_weight_lift renders a constant downward force at the end effector of a Franka Research 3 while leaving the end effector free to be lifted by hand inside the vertical X-Z plane of the robot base.</description>
  <maintainer email="tank.wenzhi.bai@gmail.com">Wenzhi Bai</maintainer>
  <license>MIT</license>

  <author>Wenzhi Bai</author>

  <buildtool_depend>catkin</buildtool_depend>

  <build_depend>eigen</build_depend>

  <depend>controller_interface</depend>
  <depend>dynamic_reconfigure</depend>
  <depend>franka_hw</depend>
  <depend>hardware_interface</depend>
  <depend>libfranka</depend>
  <depend>pluginlib</depend>
  <depend>realtime_tools</depend>
  <depend>roscpp</depend>

  <exec_depend>franka_control</exec_depend>
  <exec_depend>franka_description</exec_depend>

  <export>
    <controller_interface plugin="${prefix}/franka_controllers_plugin.xml" />
  </export>
</package>
